---
/**
 * "Continuar con Google". Solo aparece si Google está activado en Supabase.
 * El formulario va a la página actual; la página redirige a Google.
 */
import { actions } from "astro:actions";
import { isGoogleEnabled } from "../../lib/auth/providers";

interface Props {
  next?: string;
  label?: string;
  /** Página que procesa el formulario (la actual). */
  page: string;
  /** Aviso de que al registrarse con Google se aceptan los términos. */
  consent?: boolean;
}

const { next, label = "Continuar con Google", page, consent = false } = Astro.props;
const enabled = await isGoogleEnabled();
const action = `${page}${page.includes("?") ? "&" : "?"}${String(actions.auth.google).replace(/^\?/, "")}`;
---

{
  enabled && (
    <>
      <form method="POST" action={action}>
        {next && <input type="hidden" name="next" value={next} />}
        <button
          type="submit"
          class="flex h-12 w-full items-center justify-center gap-3 rounded-wl border border-line bg-surface px-4 font-semibold text-ink transition-colors hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-brand"
        >
          <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
            <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.6 5.6 0 0 1-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7Z" />
            <path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3c-1.1.7-2.5 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.3v3.1A12 12 0 0 0 12 24Z" />
            <path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6h-4a12 12 0 0 0 0 10.8l4-3.1Z" />
            <path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.3 6.6l4 3.1c.9-2.9 3.6-4.9 6.7-4.9Z" />
          </svg>
          {label}
        </button>
      </form>
      {consent && (
        <p class="mt-2 text-center text-xs text-ink-muted">
          Al registrarte con Google aceptás los <a href="/terminos" class="underline hover:text-ink">términos</a> y la{" "}
          <a href="/privacidad" class="underline hover:text-ink">política de privacidad</a>.
        </p>
      )}
      <div class="my-6 flex items-center gap-3 text-sm text-ink-muted" role="separator">
        <span class="h-px flex-1 bg-line" />o con tu email<span class="h-px flex-1 bg-line" />
      </div>
    </>
  )
}
