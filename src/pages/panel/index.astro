---
/**
 * Primeros pasos: lo que le falta al perfil para que lo encuentren.
 * Cuando el perfil está completo (o la persona elige "No mostrar más"),
 * esta página deja de aparecer y /panel lleva a "Mis publicaciones".
 */
import PanelLayout from "../../layouts/PanelLayout.astro";
import Alert from "../../components/ui/Alert.astro";
import Button from "../../components/ui/Button.astro";
import { getOwnProfile } from "../../services/profiles";
import { getMyBusinesses } from "../../services/businesses";
import { getViewerProfile } from "../../lib/viewer";
import { showOnboarding } from "../../lib/onboarding";

const { supabase, user } = Astro.locals;
const viewer = await getViewerProfile(Astro.locals);
const passwordUpdated = Astro.url.searchParams.get("password") === "updated";

if (!showOnboarding(viewer, Astro.cookies)) {
  return Astro.redirect(passwordUpdated ? "/panel/publicaciones?password=updated" : "/panel/publicaciones");
}

const [profile, businesses] = await Promise.all([getOwnProfile(supabase, user!.id), getMyBusinesses(supabase, user!.id)]);
const name = profile?.first_name ?? profile?.username ?? "";

const steps = [
  { done: Boolean(profile?.avatar_path), title: "Subí una foto", text: "Las cuentas con foto reciben muchos más mensajes.", href: "/panel/perfil" },
  { done: Boolean(profile?.bio), title: "Contá qué hacés", text: "Una descripción corta: tu oficio, tu experiencia, qué buscás.", href: "/panel/perfil" },
  { done: Boolean(profile?.city), title: "Elegí tu ciudad", text: "Así te encuentran quienes buscan cerca.", href: "/panel/perfil" },
  { done: Boolean(profile?.whatsapp || profile?.phone), title: "Agregá un teléfono", text: "Solo lo ven las personas con cuenta.", href: "/panel/perfil" },
];
const done = steps.filter((s) => s.done).length;
const percent = Math.round((done / steps.length) * 100);
---

<PanelLayout title="Primeros pasos" heading={`¡Hola${name ? `, ${name}` : ""}!`} description="Completá tu perfil para que te encuentren. Son solo unos minutos.">
  {passwordUpdated && <Alert tone="success" class="mb-6">Listo, cambiaste tu contraseña.</Alert>}

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
    <section class="rounded-wl-lg border border-line bg-surface p-5 sm:p-6" aria-labelledby="pasos">
      <div class="flex items-center justify-between gap-3">
        <h2 id="pasos" class="font-semibold">Tu perfil</h2>
        <span class="text-sm text-ink-muted">{done} de {steps.length} listos</span>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-surface-muted" role="progressbar" aria-valuenow={percent} aria-valuemin="0" aria-valuemax="100" aria-label="Perfil completo">
        <div class="h-full rounded-full bg-brand" style={{ width: `${percent}%` }}></div>
      </div>
      <ol class="mt-5 flex flex-col gap-2">
        {steps.map((s) => (
          <li>
            <a href={s.href} class:list={["flex items-center gap-3 rounded-wl border p-3", s.done ? "border-transparent opacity-70" : "border-line hover:border-brand"]}>
              <span
                class:list={["grid h-7 w-7 shrink-0 place-items-center rounded-full text-sm font-bold", s.done ? "bg-success-soft text-success" : "bg-surface-muted text-ink-muted"]}
                aria-hidden="true"
              >
                {s.done ? "✓" : "•"}
              </span>
              <span class="min-w-0 flex-1">
                <span class:list={["block font-medium", s.done && "line-through"]}>{s.title}</span>
                {!s.done && <span class="block text-sm text-ink-muted">{s.text}</span>}
              </span>
              {!s.done && <span class="text-sm font-semibold text-brand" aria-hidden="true">→</span>}
            </a>
          </li>
        ))}
      </ol>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <Button href="/panel/perfil">Completar mi perfil</Button>
        <form method="POST" action="/panel/primeros-pasos">
          <button type="submit" class="text-sm font-medium text-ink-muted hover:text-ink hover:underline">No mostrar más</button>
        </form>
      </div>
    </section>

    <aside class="flex flex-col gap-4">
      {businesses.length === 0 && (
        <section class="rounded-wl-lg border border-line bg-surface p-5">
          <h2 class="font-semibold">¿Tenés un emprendimiento?</h2>
          <p class="mt-1 text-sm text-ink-muted">Creale su página con logo, catálogo, horarios y contacto. Es opcional y gratis.</p>
          <Button href="/panel/emprendimientos/nuevo" variant="offer" size="sm" class="mt-3">Crear emprendimiento</Button>
        </section>
      )}
      <section class="rounded-wl-lg border border-line bg-surface p-5">
        <h2 class="font-semibold">Mientras tanto</h2>
        <ul class="mt-2 flex flex-col gap-1 text-sm">
          <li><a href="/panel/publicaciones/nueva" class="font-medium text-brand hover:underline">Hacé tu primera publicación</a></li>
          <li><a href="/necesidades" class="font-medium text-brand hover:underline">Mirá qué necesita la gente</a></li>
          <li><a href="/rubros" class="font-medium text-brand hover:underline">Explorá los rubros</a></li>
        </ul>
      </section>
    </aside>
  </div>
</PanelLayout>
