{
  "name": "plataforma",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "psql \"postgresql://postgres:postgres@127.0.0.1:54322/postgres\" -v ON_ERROR_STOP=1 -q -t -f supabase/tests/database/etapa2_seguridad.sql",
    "db:types": "supabase gen types typescript --local > src/types/database.types.ts",
    "db:push": "supabase db push"
  },
  "devDependencies": {
    "supabase": "^2.120.0"
  }
}